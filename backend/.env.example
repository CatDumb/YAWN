DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_READ_DOT_ENV_FILE=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://wio:wio@localhost:5432/wio
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@wio.local
DJANGO_EMAIL_TIMEOUT_SECONDS=10
# Direct Django Gmail SMTP: use dedicated account App Password in ignored backend/.env or deployment secrets.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=yawn@example.com
# DJANGO_EMAIL_HOST_PASSWORD=google-app-password
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=yawn@example.com
# DJANGO_EMAIL_TIMEOUT_SECONDS=10
WIO_APP_URL=http://localhost:3000
WIO_COMPANY_TIME_ZONE=Asia/Ho_Chi_Minh
WIO_OTP_TTL_SECONDS=600
WIO_OTP_MAX_ATTEMPTS=5
WIO_OTP_RESEND_SECONDS=60
WIO_OTP_REQUESTS_PER_HOUR=5
WIO_OTP_IP_REQUESTS_PER_HOUR=100
WIO_SIGNUP_COMPANY_SLUG=wio
WIO_SIGNUP_REQUESTS_PER_HOUR=5
WIO_SIGNUP_FINGERPRINT_REQUESTS_PER_HOUR=20
# Local-only guard for `python manage.py seed_dev_admin`; never enable outside development.
WIO_ALLOW_INSECURE_DEV_SEED=false
WIO_TRUST_PROXY_HEADERS=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
