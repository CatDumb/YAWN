DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_READ_DOT_ENV_FILE=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://wio:wio@localhost:5432/wio
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@wio.local
WIO_COMPANY_TIME_ZONE=Asia/Ho_Chi_Minh
WIO_OTP_TTL_SECONDS=600
WIO_OTP_MAX_ATTEMPTS=5
WIO_OTP_RESEND_SECONDS=60
WIO_OTP_REQUESTS_PER_HOUR=5
WIO_OTP_IP_REQUESTS_PER_HOUR=20
WIO_TRUST_PROXY_HEADERS=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
