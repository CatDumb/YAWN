POSTGRES_DB=wio
POSTGRES_USER=wio
POSTGRES_PASSWORD=change-me-for-local-development
APP_VERSION=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0

# Docker Compose reads Gmail SMTP values from this root .env file.
# Default: write mail to backend container logs.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@wio.local
WIO_APP_URL=http://localhost:3000
WIO_OTP_RESEND_SECONDS=30
WIO_OTP_REQUESTS_PER_HOUR=5
WIO_OTP_IP_REQUESTS_PER_HOUR=100
WIO_ALLOW_INSECURE_DEV_SEED=false
WIO_TRUST_PROXY_HEADERS=false

# Gmail SMTP: replace the two active mail values above and add these values.
# Use a dedicated Gmail account with 2-Step Verification and an App Password.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=yawn.noreply@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=google-app-password-without-spaces
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=yawn.noreply@gmail.com
